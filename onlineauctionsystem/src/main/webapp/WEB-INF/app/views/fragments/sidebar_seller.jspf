<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<div class="card border-0 shadow-sm">
    <div class="card-body p-3">
        <div class="nav flex-column nav-pills gap-1">
            <a class="nav-link ${activeNav == 'dashboard' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/seller/home">Dashboard</a>

            <a class="nav-link ${activeNav == 'profile' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/seller/profile">My Profile</a>

            <a class="nav-link ${activeNav == 'add-product' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/seller/product/add">Add Product</a>

            <a class="nav-link ${activeNav == 'products' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/seller/product/list">My Products</a>

            <a class="nav-link ${activeNav == 'bids' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/seller/product/bids">View Bids</a>

            <a class="nav-link ${activeNav == 'news' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/news">News</a>

            <a class="nav-link ${activeNav == 'feedback' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/feedback">Feedback</a>
        </div>
    </div>
</div>
