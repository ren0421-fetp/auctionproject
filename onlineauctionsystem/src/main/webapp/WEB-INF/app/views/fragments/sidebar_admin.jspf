<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<div class="card border-0 shadow-sm">
    <div class="card-body p-3">
        <div class="nav flex-column nav-pills gap-1">
            <a class="nav-link ${activeNav == 'dashboard' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/admin/home">Dashboard</a>

            <a class="nav-link ${activeNav == 'users' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/admin/users">Manage User</a>

            <a class="nav-link ${activeNav == 'categories' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/admin/categories">Manage Categories</a>

            <a class="nav-link ${activeNav == 'products' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/admin/products">Manage Product</a>

            <a class="nav-link ${activeNav == 'bidding' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/admin/bids/confirmations">Manage Bidding</a>

            <a class="nav-link ${activeNav == 'packages' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/admin/packages">Manage Package</a>

            <a class="nav-link ${activeNav == 'user-packages' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/admin/user-packages">Manage User Package</a>

            <a class="nav-link ${activeNav == 'locations' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/admin/locations">Manage Locations</a>

            <a class="nav-link ${activeNav == 'news' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/admin/news">Manage News</a>

            <a class="nav-link ${activeNav == 'feedback' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/admin/feedback">View Feedback</a>

            <a class="nav-link ${activeNav == 'reports' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/admin/reports">Reports</a>
        </div>
    </div>
</div>
