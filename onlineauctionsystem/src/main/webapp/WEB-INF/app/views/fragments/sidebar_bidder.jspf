<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<div class="card border-0 shadow-sm">
    <div class="card-body p-3">
        <div class="nav flex-column nav-pills gap-1">
            <a class="nav-link ${activeNav == 'dashboard' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/bidder/home">Dashboard</a>

            <a class="nav-link ${activeNav == 'auctions' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/bidder/auctions/list">Browse Auctions</a>

            <a class="nav-link ${activeNav == 'packages' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/bidder/package/list">Packages</a>

            <a class="nav-link ${activeNav == 'my-bids' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/bidder/auctions/my-bids">Show Your Bids</a>

            <a class="nav-link ${activeNav == 'news' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/news">News</a>

            <a class="nav-link ${activeNav == 'feedback' ? 'active' : 'link-dark'}"
               href="${pageContext.request.contextPath}/app/feedback">Feedback</a>
        </div>
    </div>
</div>
