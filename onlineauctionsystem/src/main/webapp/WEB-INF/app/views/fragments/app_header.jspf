<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<nav class="app-topbar">
    <div class="container-fluid px-0">
        <div class="app-topbar-inner">
            <a class="app-topbar-brand" href="${pageContext.request.contextPath}${homePath}">
                Online Auction Workspace
            </a>

            <div class="app-topbar-tools">
                <c:if test="${not empty loggedInUser}">
                    <span class="app-role-pill">${loggedInUser.userType}</span>
                    <span class="app-user-meta">
                        ${loggedInUser.firstName} ${loggedInUser.lastName}
                    </span>
                </c:if>

                <a class="btn btn-dark btn-sm rounded-pill px-3"
                   href="${pageContext.request.contextPath}/app/logout">
                    Logout
                </a>
            </div>
        </div>
    </div>
</nav>
