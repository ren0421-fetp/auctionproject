<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<nav class="navbar navbar-expand-lg navbar-dark bg-danger shadow-sm">
    <div class="container-fluid px-4">
        <a class="navbar-brand fw-semibold" href="${pageContext.request.contextPath}${homePath}">
            Online Auction
        </a>

        <div class="d-flex align-items-center gap-3 text-white">
            <c:if test="${not empty loggedInUser}">
                <span class="small text-white-50">
                    ${loggedInUser.firstName} ${loggedInUser.lastName}
                </span>
                <span class="badge text-bg-light text-dark text-uppercase">
                    ${loggedInUser.userType}
                </span>
            </c:if>

            <a class="btn btn-sm btn-outline-light" href="${pageContext.request.contextPath}/app/login">
                Logout
            </a>
        </div>
    </div>
</nav>
