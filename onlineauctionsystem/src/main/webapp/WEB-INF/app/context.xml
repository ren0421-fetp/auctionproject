<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xmlns:context="http://www.springframework.org/schema/context"
    xmlns:p="http://www.springframework.org/schema/util"
    xmlns:mvc="http://www.springframework.org/schema/mvc"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
                        http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd
                        http://www.springframework.org/schema/util http://www.springframework.org/schema/util/spring-util.xsd
                        http://www.springframework.org/schema/mvc http://www.springframework.org/schema/mvc/spring-mvc.xsd">
      <import resource="jdbc-context.xml"/>
     
     <!-- Step 2: Recognize Java Config annotations -->
     <mvc:annotation-driven  />    
     
     <!-- Step 3: Location of your beans and components -->
     <context:component-scan base-package="org.fujitsu.training.codes"/>
	
	<bean class="org.mybatis.spring.mapper.MapperScannerConfigurer">
    <property name="basePackage" value="org.fujitsu.training.codes.dao" />
</bean>

<bean id="multipartResolver" class="org.springframework.web.multipart.support.StandardServletMultipartResolver" />

     <!-- View Resolver -->
     <bean id="viewResolver1" 
         class="org.springframework.web.servlet.view.InternalResourceViewResolver">
         <property name="prefix" value="/WEB-INF/app/views"/>
         <property name="suffix" value=".jsp"/>
         <property name="order" value="1"/>
     </bean>
     
     <bean id="viewResolver2" 
        class="org.springframework.web.servlet.view.BeanNameViewResolver">
          <property name="order" value="0"/>
     </bean>
     <bean id="registerView" class="org.springframework.web.servlet.view.JstlView">
         <property name="url" value="/WEB-INF/app/views/registration/registration.jsp" />
     </bean>
      <bean id="registerSuccess" class="org.springframework.web.servlet.view.JstlView">
         <property name="url" value="/WEB-INF/app/views/registration/registration_success.jsp" />
     </bean>
     
     <!-- Error pages -->
     <bean id="errIllegalArgView" class="org.springframework.web.servlet.view.JstlView">
         <property name="url" value="/WEB-INF/app/views/errors/illegal_argument_err.jsp" />
     </bean>
     <bean id="numberFormatView" class="org.springframework.web.servlet.view.JstlView">
         <property name="url" value="/WEB-INF/app/views/errors/numberformat_err.jsp" />
     </bean>
    <!--  
     <bean id="messageSource" 
     class="org.springframework.context.support.ResourceBundleMessageSource">
        <property name="basenames">
           <list>
              <value>errors.emp_form</value>
           </list>
        </property>
     </bean>
     -->
    <!-- Managing static files -->
    <mvc:resources mapping="/cssPath/**" 
         location="classpath:/css/" />
    <mvc:resources mapping="/jsPath/**" 
         location="classpath:/js/" />
    <mvc:resources mapping="/imgPath/**" 
          location="classpath:/image/" />
   
</beans>




